<%- include('_header', { title: 'Administración' }) %>
<section class="page-heading"><div><div class="eyebrow">SOLO ADMINISTRADORES</div><h1>Panel de seguridad</h1><p class="muted">Usuarios y eventos recientes. Los registros no guardan contraseñas ni tokens.</p></div></section>
<section class="form-card wide"><h2>Usuarios</h2><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Acción</th></tr></thead><tbody><% users.forEach((u) => { %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><% if (u.id !== currentUser.id) { %><form method="post" action="/admin/users/<%= encodeURIComponent(u.id) %>/role"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>"><button class="text-button" type="submit">Cambiar a <%= u.role === 'admin' ? 'usuario' : 'administrador' %></button></form><% } else { %>Tu cuenta<% } %></td></tr><% }); %></tbody></table></div></section>
<section class="form-card wide"><h2>Bitácora de seguridad</h2><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Evento</th><th>Actor</th><th>IP</th></tr></thead><tbody><% events.forEach((e) => { %><tr><td><%= new Date(e.created_at).toLocaleString('es') %></td><td><%= e.event_type %></td><td><%= e.actor_user_id || '—' %></td><td><%= e.ip_address || '—' %></td></tr><% }); %></tbody></table></div></section>
<%- include('_footer') %>
