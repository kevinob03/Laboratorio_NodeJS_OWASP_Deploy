<%- include('_header', { title: 'Iniciar sesión' }) %>
<section class="form-card"><div class="eyebrow">QUÉ BUENO VERTE</div><h1>Iniciar sesión</h1><% if (notice) { %><div class="success" role="status"><%= notice %></div><% } %><% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %><form method="post" action="/login" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Correo<input type="email" name="email" autocomplete="username" required></label><label>Contraseña<input type="password" name="password" autocomplete="current-password" required></label><button class="button" type="submit">Entrar</button></form><p class="muted"><a href="/forgot-password">Olvidé mi contraseña</a></p><p class="muted">¿Nuevo aquí? <a href="/register">Crea una cuenta</a>.</p></section>
<%- include('_footer') %>
