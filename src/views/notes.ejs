<%- include('_header', { title: 'Mis notas' }) %>
<div class="page-heading"><div><div class="eyebrow">TU ESPACIO</div><h1>Mis notas</h1><p class="muted">Hasta 100 notas privadas. Cada una se cifra al guardarse.</p></div></div>
<section class="form-card wide"><h2>Escribe una nota</h2><form method="post" action="/notes" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Título<input name="title" maxlength="100" required></label><label>Contenido<textarea name="body" rows="5" maxlength="10000" required></textarea></label><button class="button" type="submit">Guardar nota cifrada</button></form></section>
<section class="notes-grid"><% if (notes.length) { notes.forEach((n) => { %><article class="note"><div class="note-date"><%= new Date(n.createdAt).toLocaleDateString('es') %></div><h2><a class="note-title" href="/notes/<%= encodeURIComponent(n.id) %>"><%= n.title %></a></h2><p class="note-body"><%= n.body %></p><details><summary>Editar nota</summary><form method="post" action="/notes/<%= encodeURIComponent(n.id) %>/update" class="stack edit-note"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Título<input name="title" maxlength="100" value="<%= n.title %>" required></label><label>Contenido<textarea name="body" maxlength="10000" rows="3" required><%= n.body %></textarea></label><button class="button small" type="submit">Guardar cambios</button></form></details><form method="post" action="/notes/<%= encodeURIComponent(n.id) %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger-link" type="submit">Eliminar nota</button></form></article><% }); } else { %><div class="empty"><h2>Tu espacio empieza aquí</h2><p>Escribe tu primera nota en el formulario de arriba.</p></div><% } %></section>
<%- include('_footer') %>

