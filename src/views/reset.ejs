<%- include('_header', { title: 'Nueva contraseña' }) %>
<section class="form-card"><div class="eyebrow">ENLACE DE UN SOLO USO</div><h1>Crear contraseña nueva</h1><% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %><form method="post" action="/reset-password" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><label>Nueva contraseña<input type="password" name="password" autocomplete="new-password" minlength="12" required></label><button class="button" type="submit">Guardar contraseña</button></form></section>
<%- include('_footer') %>
