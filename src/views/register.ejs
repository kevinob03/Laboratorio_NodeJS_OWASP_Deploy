<%- include('_header', { title: 'Crear cuenta' }) %>
<section class="form-card"><div class="eyebrow">EMPIEZA AQUÍ</div><h1>Crear cuenta</h1><p class="muted">La contraseña debe tener 12 caracteres o más, con mayúscula, minúscula, número y símbolo.</p><% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %><form method="post" action="/register" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nombre<input name="name" autocomplete="name" maxlength="100" required></label><label>Correo<input type="email" name="email" autocomplete="email" maxlength="254" required></label><label>Contraseña<input type="password" name="password" autocomplete="new-password" minlength="12" required></label><button class="button" type="submit">Crear mi cuenta</button></form><p class="muted">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>.</p></section>
<%- include('_footer') %>
