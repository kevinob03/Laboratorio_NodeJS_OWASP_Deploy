# Copy for local development only; never commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
TRUST_PROXY=0
RESEND_API_KEY=
MAIL_FROM=SecureVault <no-reply@example.com>
# Optional local/paid-host SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
